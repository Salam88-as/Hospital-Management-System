@model HospitalManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<h2>Doctor Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Specialization</dt>
        <dd class="col-sm-9">@Model.Specialization</dd>

        <dt class="col-sm-3">Qualification</dt>
        <dd class="col-sm-9">@Model.Qualification</dd>

        <dt class="col-sm-3">Phone Number</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Experience (Years)</dt>
        <dd class="col-sm-9">@Model.ExperienceYears</dd>

        <dt class="col-sm-3">Consultation Fee</dt>
        <dd class="col-sm-9">@Model.ConsultationFee</dd>

        <dt class="col-sm-3">Joining Date</dt>
        <dd class="col-sm-9">@Model.JoiningDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Available</dt>
        <dd class="col-sm-9">@Model.IsAvailable</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>