@model HospitalManagementSystem.Models.Insurance

@{
    ViewData["Title"] = "Delete Insurance";
}

<h2>Delete Insurance</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Provider Name</dt>
        <dd class="col-sm-9">@Model.ProviderName</dd>

        <dt class="col-sm-3">Policy Number</dt>
        <dd class="col-sm-9">@Model.PolicyNumber</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="InsuranceId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>