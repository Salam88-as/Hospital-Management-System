@model IEnumerable<HospitalManagementSystem.Models.EMR>

@{
    ViewData["Title"] = "EMR";
}

<style>
    :root {
        --ink: #0F2A43;
        --teal: #0E7C7B;
        --teal-dark: #0A5F5E;
        --mint: #EAF7F5;
        --slate: #5B6B78;
        --paper: #FBFDFC;
        --danger: #D9534F;
    }

    .list-wrap {
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .list-header h1 {
            font-family: 'Poppins','Segoe UI',sans-serif;
            font-weight: 700;
            font-size: 1.6rem;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .list-header h1::before {
                content: "";
                width: 7px;
                height: 26px;
                background: var(--teal);
                border-radius: 4px;
                display: inline-block;
            }

    .btn-add {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background .15s ease, transform .15s ease;
    }

        .btn-add:hover {
            background: var(--teal-dark);
            color: #fff;
            transform: translateY(-1px);
        }

    .table-card {
        background: var(--paper);
        border-radius: 16px;
        border: 1px solid #E4ECEA;
        box-shadow: 0 2px 10px rgba(15,42,67,.04);
        overflow: hidden;
        overflow-x: auto;
    }

    table.pro-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        table.pro-table thead th {
            background: var(--mint);
            color: var(--ink);
            font-family: 'Poppins','Segoe UI',sans-serif;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            font-weight: 600;
            padding: 14px 18px;
            text-align: left;
            border-bottom: 1px solid #DCECEA;
            white-space: nowrap;
        }

        table.pro-table tbody td {
            padding: 14px 18px;
            color: var(--ink);
            font-size: .92rem;
            border-bottom: 1px solid #EEF3F2;
            white-space: nowrap;
        }

        table.pro-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.pro-table tbody tr {
            transition: background .12s ease;
        }

            table.pro-table tbody tr:hover {
                background: var(--mint);
            }

    .name-cell {
        font-weight: 600;
    }

    .action-cell {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: .95rem;
        transition: background .12s ease, transform .12s ease;
        border: 1px solid transparent;
    }

        .icon-btn.view {
            background: #EAF3FB;
            color: #1F6FB2;
        }

            .icon-btn.view:hover {
                background: #D8EBFA;
                transform: translateY(-1px);
            }

        .icon-btn.edit {
            background: #FDF3E7;
            color: #B8730A;
        }

            .icon-btn.edit:hover {
                background: #FBE8D1;
                transform: translateY(-1px);
            }

        .icon-btn.delete {
            background: #FCEAEA;
            color: var(--danger);
        }

            .icon-btn.delete:hover {
                background: #F9D9D9;
                transform: translateY(-1px);
            }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--slate);
    }

        .empty-state .emoji {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }
</style>

<div class="list-wrap">
    <div class="list-header">
        <h1>EMR</h1>
        <a asp-action="Create" class="btn-add">+ Add New</a>
    </div>
    <div class="table-card">
        @if (Model != null && Model.Any())
        {
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Patient ID</th>
                        <th>Doctor ID</th>
                        <th>Record Date</th>
                        <th>Allergies</th>
                        <th>Chronic Conditions</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="name-cell">@item.PatientId</td>
                            <td>@item.DoctorId</td>
                            <td>@item.RecordDate.ToShortDateString()</td>
                            <td>@item.Allergies</td>
                            <td>@item.ChronicConditions</td>
                            <td>
                                <div class="action-cell">
                                    <a asp-action="Details" asp-route-id="@item.EMRId" class="icon-btn view" title="View Details">👁</a>
                                    <a asp-action="Edit" asp-route-id="@item.EMRId" class="icon-btn edit" title="Edit">✎</a>
                                    <a asp-action="Delete" asp-route-id="@item.EMRId" class="icon-btn delete" title="Delete">🗑</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <div class="emoji">📋</div>
                <p class="mb-0">No medical records found yet.</p>
            </div>
        }
    </div>
</div>