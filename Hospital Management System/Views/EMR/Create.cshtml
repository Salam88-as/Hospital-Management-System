@model HospitalManagementSystem.Models.EMR

@{
    ViewData["Title"] = "Create Medical Record";
}

<h2>Create Medical Record</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PatientId"></label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DoctorId"></label>
        <input asp-for="DoctorId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="RecordDate"></label>
        <input asp-for="RecordDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MedicalHistory"></label>
        <textarea asp-for="MedicalHistory" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="Allergies"></label>
        <textarea asp-for="Allergies" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="ChronicConditions"></label>
        <textarea asp-for="ChronicConditions" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="AttachmentPath"></label>
        <input asp-for="AttachmentPath" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>