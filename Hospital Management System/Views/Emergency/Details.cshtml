@model HospitalManagementSystem.Models.Emergency

@{
    ViewData["Title"] = "Emergency Case Details";
}

<h2>Emergency Case Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Doctor ID</dt>
        <dd class="col-sm-9">@Model.DoctorId</dd>

        <dt class="col-sm-3">Arrival Time</dt>
        <dd class="col-sm-9">@Model.ArrivalTime</dd>

        <dt class="col-sm-3">Triage Level</dt>
        <dd class="col-sm-9">@Model.TriageLevel</dd>

        <dt class="col-sm-3">Chief Complaint</dt>
        <dd class="col-sm-9">@Model.ChiefComplaint</dd>

        <dt class="col-sm-3">Action Taken</dt>
        <dd class="col-sm-9">@Model.ActionTaken</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.EmergencyId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>