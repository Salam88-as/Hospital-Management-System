@model HospitalManagementSystem.Models.Emergency

@{
    ViewData["Title"] = "Delete Emergency Case";
}

<h2>Delete Emergency Case</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Triage Level</dt>
        <dd class="col-sm-9">@Model.TriageLevel</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EmergencyId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>