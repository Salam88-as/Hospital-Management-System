@model HospitalManagementSystem.Models.OperationTheatre

@{
    ViewData["Title"] = "Delete Operation";
}

<h2>Delete Operation</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Operation Type</dt>
        <dd class="col-sm-9">@Model.OperationType</dd>

        <dt class="col-sm-3">Scheduled Date</dt>
        <dd class="col-sm-9">@Model.ScheduledDate.ToShortDateString()</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="OperationId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>