@model HospitalManagementSystem.Models.OperationTheatre

@{
    ViewData["Title"] = "Operation Details";
}

<h2>Operation Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Doctor ID</dt>
        <dd class="col-sm-9">@Model.DoctorId</dd>

        <dt class="col-sm-3">Operation Type</dt>
        <dd class="col-sm-9">@Model.OperationType</dd>

        <dt class="col-sm-3">Scheduled Date</dt>
        <dd class="col-sm-9">@Model.ScheduledDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Start Time</dt>
        <dd class="col-sm-9">@Model.StartTime</dd>

        <dt class="col-sm-3">End Time</dt>
        <dd class="col-sm-9">@Model.EndTime</dd>

        <dt class="col-sm-3">OT Room Number</dt>
        <dd class="col-sm-9">@Model.OTRoomNumber</dd>

        <dt class="col-sm-3">Pre-Op Notes</dt>
        <dd class="col-sm-9">@Model.PreOpNotes</dd>

        <dt class="col-sm-3">Post-Op Notes</dt>
        <dd class="col-sm-9">@Model.PostOpNotes</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.OperationId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>