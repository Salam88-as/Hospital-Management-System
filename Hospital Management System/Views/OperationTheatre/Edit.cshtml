@model HospitalManagementSystem.Models.OperationTheatre

@{
    ViewData["Title"] = "Edit Operation";
}

<h2>Edit Operation</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="OperationId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PatientId"></label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DoctorId"></label>
        <input asp-for="DoctorId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="OperationType"></label>
        <input asp-for="OperationType" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="ScheduledDate"></label>
        <input asp-for="ScheduledDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StartTime"></label>
        <input asp-for="StartTime" type="time" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="EndTime"></label>
        <input asp-for="EndTime" type="time" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="OTRoomNumber"></label>
        <input asp-for="OTRoomNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PreOpNotes"></label>
        <textarea asp-for="PreOpNotes" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="PostOpNotes"></label>
        <textarea asp-for="PostOpNotes" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            <option value="Scheduled">Scheduled</option>
            <option value="InProgress">InProgress</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>