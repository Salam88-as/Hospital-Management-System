@model HospitalManagementSystem.Models.IPD

@{
    ViewData["Title"] = "IPD Details";
}

<h2>IPD Admission Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Doctor ID</dt>
        <dd class="col-sm-9">@Model.DoctorId</dd>

        <dt class="col-sm-3">Ward ID</dt>
        <dd class="col-sm-9">@Model.WardId</dd>

        <dt class="col-sm-3">Room ID</dt>
        <dd class="col-sm-9">@Model.RoomId</dd>

        <dt class="col-sm-3">Admission Date</dt>
        <dd class="col-sm-9">@Model.AdmissionDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Discharge Date</dt>
        <dd class="col-sm-9">@Model.DischargeDate?.ToShortDateString()</dd>

        <dt class="col-sm-3">Admission Reason</dt>
        <dd class="col-sm-9">@Model.AdmissionReason</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Advance Payment</dt>
        <dd class="col-sm-9">@Model.AdvancePayment</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.IPDId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>