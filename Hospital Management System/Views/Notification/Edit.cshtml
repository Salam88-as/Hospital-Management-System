@model HospitalManagementSystem.Models.Notification

@{
    ViewData["Title"] = "Edit Notification";
}

<h2>Edit Notification</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="NotificationId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="RecipientUserId"></label>
        <input asp-for="RecipientUserId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="RecipientType"></label>
        <select asp-for="RecipientType" class="form-control">
            <option value="Admin">Admin</option>
            <option value="Doctor">Doctor</option>
            <option value="Nurse">Nurse</option>
            <option value="Patient">Patient</option>
            <option value="Staff">Staff</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Message"></label>
        <textarea asp-for="Message" class="form-control"></textarea>
    </div>

    <div class="form-check">
        <input asp-for="IsRead" class="form-check-input" />
        <label asp-for="IsRead" class="form-check-label"></label>
    </div>

    <div class="form-group">
        <label asp-for="Priority"></label>
        <select asp-for="Priority" class="form-control">
            <option value="Low">Low</option>
            <option value="Normal">Normal</option>
            <option value="High">High</option>
            <option value="Urgent">Urgent</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>