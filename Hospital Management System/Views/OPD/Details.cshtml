@model HospitalManagementSystem.Models.OPD

@{
    ViewData["Title"] = "OPD Details";
}

<h2>OPD Visit Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Doctor ID</dt>
        <dd class="col-sm-9">@Model.DoctorId</dd>

        <dt class="col-sm-3">Visit Date</dt>
        <dd class="col-sm-9">@Model.VisitDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Symptoms</dt>
        <dd class="col-sm-9">@Model.Symptoms</dd>

        <dt class="col-sm-3">Diagnosis</dt>
        <dd class="col-sm-9">@Model.Diagnosis</dd>

        <dt class="col-sm-3">Consultation Fee</dt>
        <dd class="col-sm-9">@Model.ConsultationFee</dd>

        <dt class="col-sm-3">Token Number</dt>
        <dd class="col-sm-9">@Model.TokenNumber</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.OPDId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>