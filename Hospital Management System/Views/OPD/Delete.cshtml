@model HospitalManagementSystem.Models.OPD

@{
    ViewData["Title"] = "Delete OPD Visit";
}

<h2>Delete OPD Visit</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Visit Date</dt>
        <dd class="col-sm-9">@Model.VisitDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Diagnosis</dt>
        <dd class="col-sm-9">@Model.Diagnosis</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="OPDId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>