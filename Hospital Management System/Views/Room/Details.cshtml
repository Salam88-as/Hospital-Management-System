@model HospitalManagementSystem.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<h2>Room Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Ward ID</dt>
        <dd class="col-sm-9">@Model.WardId</dd>

        <dt class="col-sm-3">Room Number</dt>
        <dd class="col-sm-9">@Model.RoomNumber</dd>

        <dt class="col-sm-3">Room Type</dt>
        <dd class="col-sm-9">@Model.RoomType</dd>

        <dt class="col-sm-3">Bed Capacity</dt>
        <dd class="col-sm-9">@Model.BedCapacity</dd>

        <dt class="col-sm-3">Occupied Beds</dt>
        <dd class="col-sm-9">@Model.OccupiedBeds</dd>

        <dt class="col-sm-3">Daily Charges</dt>
        <dd class="col-sm-9">@Model.DailyCharges</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>