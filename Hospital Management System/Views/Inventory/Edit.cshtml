@model HospitalManagementSystem.Models.Inventory

@{
    ViewData["Title"] = "Edit Inventory Item";
}

<h2>Edit Inventory Item</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="InventoryId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ItemName"></label>
        <input asp-for="ItemName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Category"></label>
        <input asp-for="Category" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="QuantityInStock"></label>
        <input asp-for="QuantityInStock" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="ReorderLevel"></label>
        <input asp-for="ReorderLevel" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="SupplierName"></label>
        <input asp-for="SupplierName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="UnitCost"></label>
        <input asp-for="UnitCost" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="LastRestockedDate"></label>
        <input asp-for="LastRestockedDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StorageLocation"></label>
        <input asp-for="StorageLocation" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>