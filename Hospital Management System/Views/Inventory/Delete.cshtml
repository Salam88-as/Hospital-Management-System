@model HospitalManagementSystem.Models.Inventory

@{
    ViewData["Title"] = "Delete Inventory Item";
}

<h2>Delete Inventory Item</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Item Name</dt>
        <dd class="col-sm-9">@Model.ItemName</dd>

        <dt class="col-sm-3">Quantity In Stock</dt>
        <dd class="col-sm-9">@Model.QuantityInStock</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="InventoryId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>