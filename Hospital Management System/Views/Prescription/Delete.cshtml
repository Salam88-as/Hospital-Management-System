@model HospitalManagementSystem.Models.Prescription

@{
    ViewData["Title"] = "Delete Prescription";
}

<h2>Delete Prescription</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Medicine Name</dt>
        <dd class="col-sm-9">@Model.MedicineName</dd>

        <dt class="col-sm-3">Prescription Date</dt>
        <dd class="col-sm-9">@Model.PrescriptionDate.ToShortDateString()</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PrescriptionId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>