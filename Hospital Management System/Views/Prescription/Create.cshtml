@model HospitalManagementSystem.Models.Prescription

@{
    ViewData["Title"] = "Create Prescription";
}

<h2>Create Prescription</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PatientId"></label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DoctorId"></label>
        <input asp-for="DoctorId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PrescriptionDate"></label>
        <input asp-for="PrescriptionDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MedicineName"></label>
        <input asp-for="MedicineName" class="form-control" />
        <span asp-validation-for="MedicineName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Dosage"></label>
        <input asp-for="Dosage" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Frequency"></label>
        <input asp-for="Frequency" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Duration"></label>
        <input asp-for="Duration" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructions"></label>
        <textarea asp-for="Instructions" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>