@model HospitalManagementSystem.Models.Laboratory

@{
    ViewData["Title"] = "Lab Test Details";
}

<h2>Lab Test Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Doctor ID</dt>
        <dd class="col-sm-9">@Model.DoctorId</dd>

        <dt class="col-sm-3">Test Name</dt>
        <dd class="col-sm-9">@Model.TestName</dd>

        <dt class="col-sm-3">Sample Collected On</dt>
        <dd class="col-sm-9">@Model.SampleCollectedOn.ToShortDateString()</dd>

        <dt class="col-sm-3">Result Date</dt>
        <dd class="col-sm-9">@Model.ResultDate?.ToShortDateString()</dd>

        <dt class="col-sm-3">Result Value</dt>
        <dd class="col-sm-9">@Model.ResultValue</dd>

        <dt class="col-sm-3">Normal Range</dt>
        <dd class="col-sm-9">@Model.NormalRange</dd>

        <dt class="col-sm-3">Test Fee</dt>
        <dd class="col-sm-9">@Model.TestFee</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.LabTestId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>