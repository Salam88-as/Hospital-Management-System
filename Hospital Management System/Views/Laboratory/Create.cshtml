@model HospitalManagementSystem.Models.Laboratory

@{
    ViewData["Title"] = "Create Lab Test";
}

<h2>Create Lab Test</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PatientId"></label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DoctorId"></label>
        <input asp-for="DoctorId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="TestName"></label>
        <input asp-for="TestName" class="form-control" />
        <span asp-validation-for="TestName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SampleCollectedOn"></label>
        <input asp-for="SampleCollectedOn" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="ResultDate"></label>
        <input asp-for="ResultDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="ResultValue"></label>
        <textarea asp-for="ResultValue" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="NormalRange"></label>
        <input asp-for="NormalRange" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="TestFee"></label>
        <input asp-for="TestFee" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>