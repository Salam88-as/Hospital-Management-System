@model HospitalManagementSystem.Models.Housekeeping

@{
    ViewData["Title"] = "Housekeeping Task Details";
}

<h2>Housekeeping Task Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Room ID</dt>
        <dd class="col-sm-9">@Model.RoomId</dd>

        <dt class="col-sm-3">Task Description</dt>
        <dd class="col-sm-9">@Model.TaskDescription</dd>

        <dt class="col-sm-3">Assigned Staff ID</dt>
        <dd class="col-sm-9">@Model.AssignedStaffId</dd>

        <dt class="col-sm-3">Task Date</dt>
        <dd class="col-sm-9">@Model.TaskDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Completed Time</dt>
        <dd class="col-sm-9">@Model.CompletedTime</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.HousekeepingId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>