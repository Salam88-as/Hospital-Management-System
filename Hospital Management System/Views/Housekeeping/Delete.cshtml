@model HospitalManagementSystem.Models.Housekeeping

@{
    ViewData["Title"] = "Delete Housekeeping Task";
}

<h2>Delete Housekeeping Task</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Task Description</dt>
        <dd class="col-sm-9">@Model.TaskDescription</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="HousekeepingId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>