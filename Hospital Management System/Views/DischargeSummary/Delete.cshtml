@model HospitalManagementSystem.Models.DischargeSummary

@{
    ViewData["Title"] = "Delete Discharge Summary";
}

<h2>Delete Discharge Summary</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Discharge Date</dt>
        <dd class="col-sm-9">@Model.DischargeDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Condition</dt>
        <dd class="col-sm-9">@Model.ConditionOnDischarge</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="DischargeSummaryId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>