@model HospitalManagementSystem.Models.DietNutrition

@{
    ViewData["Title"] = "Edit Diet Plan";
}

<h2>Edit Diet Plan</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="DietPlanId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PatientId"></label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MealType"></label>
        <select asp-for="MealType" class="form-control">
            <option value="Breakfast">Breakfast</option>
            <option value="Lunch">Lunch</option>
            <option value="Dinner">Dinner</option>
            <option value="Snacks">Snacks</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="DietDescription"></label>
        <textarea asp-for="DietDescription" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="DietaryRestrictions"></label>
        <input asp-for="DietaryRestrictions" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="EffectiveDate"></label>
        <input asp-for="EffectiveDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PrescribedBy"></label>
        <input asp-for="PrescribedBy" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>