@model HospitalManagementSystem.Models.DietNutrition

@{
    ViewData["Title"] = "Delete Diet Plan";
}

<h2>Delete Diet Plan</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Meal Type</dt>
        <dd class="col-sm-9">@Model.MealType</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="DietPlanId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>