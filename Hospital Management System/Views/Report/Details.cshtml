@model HospitalManagementSystem.Models.Report

@{
    ViewData["Title"] = "Report Details";
}

<h2>Report Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Report Name</dt>
        <dd class="col-sm-9">@Model.ReportName</dd>

        <dt class="col-sm-3">Report Type</dt>
        <dd class="col-sm-9">@Model.ReportType</dd>

        <dt class="col-sm-3">Generated On</dt>
        <dd class="col-sm-9">@Model.GeneratedOn.ToShortDateString()</dd>

        <dt class="col-sm-3">Generated By User ID</dt>
        <dd class="col-sm-9">@Model.GeneratedByUserId</dd>

        <dt class="col-sm-3">File Path</dt>
        <dd class="col-sm-9">@Model.FilePath</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.ReportId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>