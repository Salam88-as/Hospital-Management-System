<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@600&display=swap" rel="stylesheet">
    <style>
            body {
                background-color: #f5f7fa;
            }

            .navbar-brand {
                font-weight: bold;
            }

            .dropdown-menu {
                max-height: 400px;
                overflow-y: auto;
            }

            footer {
                padding: 15px 0;
                background-color: #212529;
                color: #fff;
                margin-top: 40px;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">🏥 Hospital Management System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Patient Management</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Patient" asp-action="Index">Patients</a></li>
                                <li><a class="dropdown-item" asp-controller="Appointment" asp-action="Index">Appointments</a></li>
                                <li><a class="dropdown-item" asp-controller="OPD" asp-action="Index">OPD</a></li>
                                <li><a class="dropdown-item" asp-controller="IPD" asp-action="Index">IPD</a></li>
                                <li><a class="dropdown-item" asp-controller="EMR" asp-action="Index">EMR</a></li>
                                <li><a class="dropdown-item" asp-controller="IR" asp-action="Index">Investigation Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="Prescription" asp-action="Index">Prescriptions</a></li>
                                <li><a class="dropdown-item" asp-controller="DischargeSummary" asp-action="Index">Discharge Summary</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Clinical Services</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Laboratory" asp-action="Index">Laboratory</a></li>
                                <li><a class="dropdown-item" asp-controller="Pharmacy" asp-action="Index">Pharmacy</a></li>
                                <li><a class="dropdown-item" asp-controller="BloodBank" asp-action="Index">Blood Bank</a></li>
                                <li><a class="dropdown-item" asp-controller="OperationTheatre" asp-action="Index">Operation Theatre</a></li>
                                <li><a class="dropdown-item" asp-controller="Emergency" asp-action="Index">Emergency</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Human Resources</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Doctor" asp-action="Index">Doctors</a></li>
                                <li><a class="dropdown-item" asp-controller="Nurse" asp-action="Index">Nurses</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index">Staff</a></li>
                                <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index">Attendance</a></li>
                                <li><a class="dropdown-item" asp-controller="Shift" asp-action="Index">Shifts</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Facility & Operations</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Ward" asp-action="Index">Wards</a></li>
                                <li><a class="dropdown-item" asp-controller="Room" asp-action="Index">Rooms</a></li>
                                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Index">Inventory</a></li>
                                <li><a class="dropdown-item" asp-controller="DietNutrition" asp-action="Index">Diet & Nutrition</a></li>
                                <li><a class="dropdown-item" asp-controller="Housekeeping" asp-action="Index">Housekeeping</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Finance</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Billing" asp-action="Index">Billing</a></li>
                                <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Index">Payroll</a></li>
                                <li><a class="dropdown-item" asp-controller="Insurance" asp-action="Index">Insurance</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Administration</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="Index">Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="Notification" asp-action="Index">Notifications</a></li>
                                <li><a class="dropdown-item" asp-controller="AuditLog" asp-action="Index">Audit Log</a></li>
                                <li><a class="dropdown-item" asp-controller="AnalyticsDashboard" asp-action="Index">Analytics Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="FeedbackComplaint" asp-action="Index">Feedback & Complaints</a></li>
                            </ul>
                        </li>

                    </ul>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item">
                                <span class="nav-link text-white">👤 @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                                </form>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center">
        &copy; @DateTime.Now.Year - Hospital Management System
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>