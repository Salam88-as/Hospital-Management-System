@model HospitalManagementSystem.Models.Shift

@{
    ViewData["Title"] = "Delete Shift";
}

<h2>Delete Shift</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Employee ID</dt>
        <dd class="col-sm-9">@Model.EmployeeId</dd>

        <dt class="col-sm-3">Shift Name</dt>
        <dd class="col-sm-9">@Model.ShiftName</dd>

        <dt class="col-sm-3">Shift Date</dt>
        <dd class="col-sm-9">@Model.ShiftDate.ToShortDateString()</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ShiftId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>