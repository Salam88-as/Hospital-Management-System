@model HospitalManagementSystem.Models.AnalyticsDashboard

@{
    ViewData["Title"] = "Delete Analytics Metric";
}

<h2>Delete Analytics Metric</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Metric Name</dt>
        <dd class="col-sm-9">@Model.MetricName</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="AnalyticsId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>