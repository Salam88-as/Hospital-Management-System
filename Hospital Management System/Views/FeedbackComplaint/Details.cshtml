@model HospitalManagementSystem.Models.FeedbackComplaint

@{
    ViewData["Title"] = "Feedback Details";
}

<h2>Feedback / Complaint Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Rating</dt>
        <dd class="col-sm-9">@Model.Rating</dd>

        <dt class="col-sm-3">Submitted On</dt>
        <dd class="col-sm-9">@Model.SubmittedOn.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Resolution Notes</dt>
        <dd class="col-sm-9">@Model.ResolutionNotes</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.FeedbackId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>