@model HospitalManagementSystem.Models.IR

@{
    ViewData["Title"] = "Investigation Report Details";
}

<h2>Investigation Report Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Doctor ID</dt>
        <dd class="col-sm-9">@Model.DoctorId</dd>

        <dt class="col-sm-3">Report Type</dt>
        <dd class="col-sm-9">@Model.ReportType</dd>

        <dt class="col-sm-3">Report Date</dt>
        <dd class="col-sm-9">@Model.ReportDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Findings</dt>
        <dd class="col-sm-9">@Model.Findings</dd>

        <dt class="col-sm-3">Impression</dt>
        <dd class="col-sm-9">@Model.Impression</dd>

        <dt class="col-sm-3">Report File</dt>
        <dd class="col-sm-9">@Model.ReportFilePath</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.IRId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>