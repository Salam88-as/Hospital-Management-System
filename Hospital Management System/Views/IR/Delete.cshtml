@model HospitalManagementSystem.Models.IR

@{
    ViewData["Title"] = "Delete Investigation Report";
}

<h2>Delete Investigation Report</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Patient ID</dt>
        <dd class="col-sm-9">@Model.PatientId</dd>

        <dt class="col-sm-3">Report Type</dt>
        <dd class="col-sm-9">@Model.ReportType</dd>

        <dt class="col-sm-3">Report Date</dt>
        <dd class="col-sm-9">@Model.ReportDate.ToShortDateString()</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IRId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>