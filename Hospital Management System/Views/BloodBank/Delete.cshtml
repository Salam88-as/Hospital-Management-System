@model HospitalManagementSystem.Models.BloodBank

@{
    ViewData["Title"] = "Delete Blood Unit";
}

<h2>Delete Blood Unit</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Blood Group</dt>
        <dd class="col-sm-9">@Model.BloodGroup</dd>

        <dt class="col-sm-3">Units Available</dt>
        <dd class="col-sm-9">@Model.UnitsAvailable</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BloodUnitId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>