@model HospitalManagementSystem.Models.BloodBank

@{
    ViewData["Title"] = "Blood Unit Details";
}

<h2>Blood Unit Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Blood Group</dt>
        <dd class="col-sm-9">@Model.BloodGroup</dd>

        <dt class="col-sm-3">Units Available</dt>
        <dd class="col-sm-9">@Model.UnitsAvailable</dd>

        <dt class="col-sm-3">Donor Name</dt>
        <dd class="col-sm-9">@Model.DonorName</dd>

        <dt class="col-sm-3">Donor Contact</dt>
        <dd class="col-sm-9">@Model.DonorContact</dd>

        <dt class="col-sm-3">Collection Date</dt>
        <dd class="col-sm-9">@Model.CollectionDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Expiry Date</dt>
        <dd class="col-sm-9">@Model.ExpiryDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.BloodUnitId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>